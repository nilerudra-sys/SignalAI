# Supabase project settings.
# Find these at: https://supabase.com/dashboard/project/_/settings/api
# (Project Settings -> API -> "Project URL" and "Publishable key")
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (same page, "Secret key"). Used ONLY by server-side scripts
# (e.g. npm run scrape) that need to bypass Row Level Security — never
# expose this to the browser, never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Gemini API key (free tier). Get one at https://aistudio.google.com/apikey.
# Used by lib/summarize.ts to turn a raw diff into a structured change
# summary — server-side only, never expose this to the browser.
GEMINI_API_KEY=
# Optional — defaults to gemini-3.6-flash if unset.
GEMINI_MODEL=

# Resend API key. Get one at https://resend.com/api-keys.
# Used by scripts/send-digests.ts to send the weekly digest email —
# server-side only, never expose this to the browser.
RESEND_API_KEY=
# Optional — defaults to Resend's shared onboarding@resend.dev sender, which
# only delivers to your own Resend account email until you verify a domain.
RESEND_FROM_EMAIL=
# Optional — used to build the "Manage email preferences" link in the digest
# email. Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
